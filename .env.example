# Copy to .env and fill in values. Never commit .env or .env.production.

# Local Supabase (`supabase start` then `supabase status`). Preferred for development.
# VITE_SUPABASE_URL="http://127.0.0.1:54321"
# VITE_SUPABASE_PUBLISHABLE_KEY="local-anon-key-from-supabase-status"
# VITE_SUPABASE_PROJECT_ID="property-task-pro"
# SUPABASE_SERVICE_ROLE_KEY="local-service-role-from-supabase-status"

# Hosted override (staging only — not production gbtexoyvfpnduykmxunc as a playground)
VITE_SUPABASE_PROJECT_ID="your-supabase-project-id"
VITE_SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-key"
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"

# Production app URL for auth email/OAuth redirects.
# Must be the product origin — never the marketing host.
# VITE_APP_URL="https://app.filla.app"

# Public marketing origin (www.filla.app). Used for links out of the app only.
# Never used for auth redirects.
# VITE_MARKETING_URL="https://www.filla.app"

# Social sign-in: enable each provider in Supabase Dashboard → Authentication → Providers
# (Google / Apple / Facebook) and allowlist redirect URL: {VITE_APP_URL or origin}/auth/callback
#
# Password reset: allowlist {VITE_APP_URL or origin}/reset-password under
# Authentication → URL Configuration → Redirect URLs (otherwise recovery emails
# fall back to Site URL / login).

# Local scripts and Supabase CLI only — never expose in the frontend bundle.
# NEVER prefix with VITE_ (that would embed the service role key in the client build).
# NEVER add this to Vercel/production frontend env vars.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
# Database password for `supabase db push` to a **non-production** linked project
# (Dashboard → Settings → Database). Never use this to reset production.
# SUPABASE_DB_PASSWORD="your-database-password"

# PostHog product analytics (EU Cloud). Key is public — safe in frontend.
# Add to Vercel environment variables for production.
VITE_POSTHOG_KEY="phc_xxxxxxxxxxxx"

# Google Maps Platform — Places Autocomplete for property addresses (public key; restrict by HTTP referrer).
# Enable "Maps JavaScript API" and "Places API" in Google Cloud Console.
# VITE_GOOGLE_MAPS_API_KEY="your-google-maps-api-key"

# Supabase Edge Functions only — Geocoding, Address Validation, Air Quality, Pollen.
# GOOGLE_MAPS_SERVER_KEY="your-google-maps-server-api-key"
#
# Knowledge AI (Supabase Edge Function secrets — set via `supabase secrets set`):
# FILLA_KNOWLEDGE_GEMINI_API_KEY="your-gemini-api-key"
# GEMINI_FLASH_MODEL="gemini-3.6-flash"   # optional; see scripts/smoke-knowledge-ai.mjs

# Optional: enable DevTools on a non-local *staging* deployment only.
# NEVER set VITE_APP_DEV_BUILD or VITE_DEV_TEST_PASSWORD on production (app.filla.app).
# Even with VITE_APP_DEV_BUILD=true, Dev Tools UI is limited to the email allowlist
# in src/lib/dev/devToolsAccess.ts (Justin + Matt). Customers never see it.
# VITE_APP_DEV_BUILD=true

# Optional: deploy sync-dev-mode edge function, then set to call it from the app.
# VITE_SYNC_DEV_MODE_EDGE=true

# Optional: password for DevTools → Switch test user (TEST-01 … TEST-06).
# Local/staging only — never production. Prefer unset in CI/prod builds.
# VITE_DEV_TEST_PASSWORD=TestPassword123!

# ---------------------------------------------------------------------------
# Stripe (Supabase Edge Functions secrets — never Vite-prefix these)
# Set via `supabase secrets set` / Dashboard. Required for Phase 3 checkout.
# NEVER put STRIPE_* in Vercel frontend env or any VITE_* variable.
# ---------------------------------------------------------------------------
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# APP_URL=http://localhost:5173
# STRIPE_PRICE_HOME_PLUS=price_...
# STRIPE_PRICE_PORTFOLIO_2_5=price_...
# STRIPE_PRICE_PORTFOLIO_6_15=price_...
# STRIPE_PRICE_PORTFOLIO_16_40=price_...
# STRIPE_PRICE_BUSINESS=price_...
# STRIPE_PRICE_SEAT_ADDON=price_...
# STRIPE_PRICE_STORAGE_PACK=price_...   # 10 GiB evidence pack unit
# STRIPE_PRICE_AI_PACK=price_...        # 100 AI ops unit
# STRIPE_PRICE_MESSAGING_PACK=price_... # 100 premium messaging units
